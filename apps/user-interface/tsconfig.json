{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vite/client", "vitest/globals"],
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "#components/*": ["src/components/*"],
      "#stores/*": ["src/stores/*"],
      "#styles/*": ["src/styles/*"],
      "#apps/*": ["src/apps/*"],
      "#i18n/*": ["src/i18n/*"],
      "#services/*": ["src/services/*"],
      "#test/*": ["src/test/*"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
